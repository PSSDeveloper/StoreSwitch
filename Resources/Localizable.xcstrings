    "permission.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS allows apps with this permission to control other apps. You can turn it off at any time in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会允许获授权的 App 控制其他应用。\n你可以随时在系统设置中关闭这项权限。"
          }
        }
      }
