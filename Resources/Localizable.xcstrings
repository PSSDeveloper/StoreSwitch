{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "about.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch App Store accounts from the macOS menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS 菜单栏快速切换 App Store 账号。"
          }
        }
      }
    },
    "about.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        }
      }
    },
    "accounts.accountRegion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Region"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号地区"
          }
        }
      }
    },
    "accounts.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加账号"
          }
        }
      }
    },
    "accounts.autoSignIn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto Sign-In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动登录"
          }
        }
      }
    },
    "accounts.autoSignInHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the email address to set up auto sign-in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存邮箱后可设置自动登录。"
          }
        }
      }
    },
    "accounts.changePassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Password…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改密码…"
          }
        }
      }
    },
    "accounts.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账号"
          }
        }
      }
    },
    "accounts.deleteHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account when you save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存时删除账号"
          }
        }
      }
    },
    "accounts.email": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account Email"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account 邮箱"
          }
        }
      }
    },
    "accounts.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Accounts Yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有账号"
          }
        }
      }
    },
    "accounts.emptyDetails": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Add Account to enter an Apple Account email address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「添加账号」填写 Apple Account 邮箱。"
          }
        }
      }
    },
    "accounts.invalidEmail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid email address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的账号邮箱。"
          }
        }
      }
    },
    "accounts.list": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号列表"
          }
        }
      }
    },
    "accounts.region": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Region"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区"
          }
        }
      }
    },
    "accounts.removePassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除密码"
          }
        }
      }
    },
    "accounts.savingPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving password…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存密码…"
          }
        }
      }
    },
    "accounts.setPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Password…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置密码…"
          }
        }
      }
    },
    "app.statusItem": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Account Switcher"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 账号切换"
          }
        }
      }
    },
    "common.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "common.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "common.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "common.later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        }
      }
    },
    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "common.reopen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开"
          }
        }
      }
    },
    "common.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "common.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知"
          }
        }
      }
    },
    "common.viewLogAndRetry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the StoreSwitch log, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看 StoreSwitch 的操作日志后重试。"
          }
        }
      }
    },
    "error.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoreSwitch is working with the App Store. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理 App Store，请稍后再试。"
          }
        }
      }
    },
    "error.notFrontmost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the App Store to the front, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 未能成为前台，请打开它后重试。"
          }
        }
      }
    },
    "error.operationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the App Store and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未能完成，请在 App Store 检查后重试。"
          }
        }
      }
    },
    "error.permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Accessibility access in System Settings, then continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置开启辅助功能，再继续。"
          }
        }
      }
    },
    "error.processChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store restarted. Check its window before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 已重新启动，请检查原生界面后继续。"
          }
        }
      }
    },
    "error.storeUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store could not be opened or read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统 App Store 未打开或无法读取。"
          }
        }
      }
    },
    "guidance.filled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoreSwitch tried to fill in the email address. Verify it, then sign in to the App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已尝试预填邮箱。请核对后在 App Store 登录。"
          }
        }
      }
    },
    "guidance.finishSignOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respond to the App Store’s sign-out prompt or sign out manually before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请处理 App Store 的退出提示，或手动退出后再继续。"
          }
        }
      }
    },
    "guidance.initialCheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the App Store to load, then check again to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等 App Store 加载后，可以重新检查并继续。"
          }
        }
      }
    },
    "guidance.keychain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS requests Keychain access, approve it in the system prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 macOS 请求访问钥匙串，请在系统提示中确认。"
          }
        }
      }
    },
    "guidance.openSignIn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Apple’s sign-in form, or check your sign-in status once you’re done."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Apple 的登录表单，或在完成登录后检查状态。"
          }
        }
      }
    },
    "guidance.signOutUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-out hasn’t been detected yet. Check the App Store before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检测到退出。请在 App Store 检查退出状态后再继续。"
          }
        }
      }
    },
    "guidance.submissionUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the App Store to see if sign-in was submitted and complete any Apple verification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 App Store 查看登录是否已提交，并完成 Apple 要求的验证。"
          }
        }
      }
    },
    "guidance.submitted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was submitted. Complete any Apple verification in the App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提交登录。如有 Apple 验证提示，请在 App Store 完成。"
          }
        }
      }
    },
    "guidance.writeUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoreSwitch couldn’t confirm that the email address was filled. Check it in the App Store before signing in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认邮箱是否填入。请在 App Store 核对后登录。"
          }
        }
      }
    },
    "keychain.authCancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain access was canceled. Try again and approve the macOS prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消系统钥匙串授权。重试时请在 macOS 提示中确认。"
          }
        }
      }
    },
    "keychain.authDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your login keychain and allow StoreSwitch access in the macOS prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未授权此次操作。请确认登录钥匙串已解锁，并在系统提示中允许 StoreSwitch 访问。"
          }
        }
      }
    },
    "keychain.decodeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the password record in the keychain. Check the StoreSwitch log."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取钥匙串中的密码记录。可查看 StoreSwitch 的操作日志。"
          }
        }
      }
    },
    "keychain.emptyPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a password to save it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码留空时不会保存。"
          }
        }
      }
    },
    "keychain.enable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to Keychain and Enable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存入钥匙串并启用"
          }
        }
      }
    },
    "keychain.enterPassword": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入密码"
          }
        }
      }
    },
    "keychain.operation.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add password record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增密码记录"
          }
        }
      }
    },
    "keychain.operation.checkSignature": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the running app’s signature"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查正在运行的应用签名"
          }
        }
      }
    },
    "keychain.operation.decodeLegacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decode legacy password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解码旧密码"
          }
        }
      }
    },
    "keychain.operation.decodeVault": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decode password vault"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解码密码库"
          }
        }
      }
    },
    "keychain.operation.findLegacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find legacy password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找旧密码"
          }
        }
      }
    },
    "keychain.operation.readData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read password data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取密码数据"
          }
        }
      }
    },
    "keychain.operation.readRecord": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read password record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取密码记录"
          }
        }
      }
    },
    "keychain.operation.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove password record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除密码记录"
          }
        }
      }
    },
    "keychain.operation.update": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update password record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新密码记录"
          }
        }
      }
    },
    "keychain.operationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keychain operation failed (%d). Check the StoreSwitch log."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙串操作失败（%d）。可查看 StoreSwitch 的操作日志。"
          }
        }
      }
    },
    "keychain.password": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Account 密码"
          }
        }
      }
    },
    "keychain.removeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Remove Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移除账号密码"
          }
        }
      }
    },
    "keychain.reopen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen StoreSwitch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新打开 StoreSwitch"
          }
        }
      }
