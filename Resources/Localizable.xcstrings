          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标：%@\n\nStoreSwitch 将退出当前 App Store 账号，然后尝试预填目标邮箱。请在 App Store 完成 Apple 要求的验证。"
