    "switch.confirm.automatic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target: %@\n\nStoreSwitch will sign out of the current App Store account, then try to sign in with the password from your keychain. Complete any Apple verification in the App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标：%@\n\nStoreSwitch 将退出当前 App Store 账号，然后尝试使用钥匙串中的密码在 App Store 提交登录。请在 App Store 完成 Apple 要求的验证。"
          }
        }
      }
    },
