    "permission.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StoreSwitch uses this permission to check App Store sign-in status and help you sign out and in when switching accounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StoreSwitch 用这项权限检查 App Store 的登录状态，\n并在你切换账号时协助退出与登录。"
          }
        }
      }
    },
    "permission.reopenSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次打开系统设置"
          }
        }
      }
    },
    "permission.replaceOldApp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the list shows an older version, remove it and add the current app. Restart StoreSwitch if needed, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若列表中是旧版本，请移除旧条目并添加当前 App。必要时重启 StoreSwitch，再检查授权。"
          }
        }
      }
    },
    "permission.returnForCheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return here after enabling access. StoreSwitch will check automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后回到这里，StoreSwitch 会自动检查。"
